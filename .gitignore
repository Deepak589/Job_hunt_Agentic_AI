# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env

# JobPilot generated
data/chroma/
data/checkpoints.db*
# Globbed, not exact: sqlite writes jobpilot.db-journal / -wal / -shm beside the db, and
# the bare `data/jobpilot.db` line left those untracked-but-not-ignored — one `git add -A`
# away from committing the journal of the private jobs DB.
data/jobpilot.db*
out/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# graphify's AST cache: regenerated by every `graphify update .` (CLAUDE.md runs it at
# session end), 59 files / ~3MB of churn per run. The graph itself (graph.json,
# GRAPH_REPORT.md, wiki/) stays tracked — only the cache is derived.
graphify-out/cache/
# FUSE leftovers: the mount leaves .fuse_hiddenXXXX beside a file that was deleted
# while still open (the sqlite DBs, during a run). They are byte-for-byte copies of
# private data and reappear with new suffixes, so ignore the pattern, not the names.
data/.fuse_hidden*

# personal data — see data/*.example.* for the schema
data/master_profile.yaml
data/cv_data.json
main_cv.pdf
main_cv_v2.pdf
templates/assets/photo.jpg

# macOS
.DS_Store

# generated application packages — personal documents, never committed
# (CLAUDE.md: "Never commit ... the CV PDF or anything in out/").
# jd.md / reason.md under Examples/ stay tracked: they are the decision record.
Examples/**/*.pdf
Examples/**/*.docx

# scratch JD inbox
JD/

# run log — append-only, churns on every run
data/jobpilot.log.jsonl
